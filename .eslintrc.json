{
	"env": {
		"browser": false,
		"commonjs": true,
		"es2022": true,
		"node": true,
		"mocha": true
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"ecmaFeatures": {
			"jsx": true
		},
		"sourceType": "module"
	},
	"overrides": [
		{
			"files": ["media/**/*.js"],
			"env": {
				"browser": true,
				"node": false
			},
			"globals": {
				"acquireVsCodeApi": "readonly"
			}
		}
	],
	"rules": {
		"no-const-assign": "warn",
		"no-this-before-super": "warn",
		"no-undef": "warn",
		"no-unreachable": "warn",
		"no-unused-vars": "warn",
		"constructor-super": "warn",
		"valid-typeof": "warn"
	}
}
