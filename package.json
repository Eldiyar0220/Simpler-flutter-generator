{
  "name": "simpler-flutter-generator",
  "displayName": "Simpler Flutter Generator",
  "description": "Generate Flutter clean architecture features (MVVM, Bloc, Cubit) from yaml and type-safe asset classes. Visual Architecture Studio and Images Studio included.",
  "version": "2.0.1",
  "publisher": "Eldiyar-Dev",
  "license": "MIT",
  "icon": "images/simpler_flutter_generator.png",
  "galleryBanner": {
    "color": "#1a8cff",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Eldiyar0220/Simpler-flutter-generator"
  },
  "bugs": {
    "url": "https://github.com/Eldiyar0220/Simpler-flutter-generator/issues"
  },
  "homepage": "https://github.com/Eldiyar0220/Simpler-flutter-generator#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "flutter",
    "dart",
    "clean architecture",
    "mvvm",
    "bloc",
    "cubit",
    "generator",
    "assets",
    "build_runner",
    "yaml"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:dart",
    "onLanguage:yaml",
    "onLanguage:dart-flutter",
    "onStartupFinished",
    "workspaceContains:**/pubspec.yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simpler-flutter-generator",
          "title": "GENERATOR",
          "icon": "media/ios_assets.svg"
        }
      ]
    },
    "views": {
      "simpler-flutter-generator": [
        {
          "id": "simplerFlutterGenerator.home",
          "name": "Simpler Flutter Generator",
          "when": "!simplerFlutterGenerator.tasksInstalled"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "simplerFlutterGenerator.home",
        "contents": "[Открыть меню](command:simpler_flutter_generator.openMenu)"
      }
    ],
    "commands": [
      {
        "command": "simpler_flutter_generator.build_runner_with_filter",
        "title": "1) Build Runner with Filter",
        "icon": "sync"
      },
      {
        "command": "simpler_flutter_generator.build_runner_with_filter_editor",
        "title": "1) Build Runner with Filter ... 🔎✅",
        "icon": "sync"
      },
      {
        "command": "simpler_flutter_generator.generateImages",
        "title": "2) Generate Assets"
      },
      {
        "command": "simpler_flutter_generator.enableCodeLensCommand",
        "title": "1) PackageLens Simpler Flutter"
      },
      {
        "command": "simpler_flutter_generator.generateFromYaml",
        "title": "3) Generate Architecture",
        "icon": "sync"
      },
      {
        "command": "simpler_flutter_generator.openMenu",
        "title": "Simpler Flutter",
        "icon": "home"
      },
      {
        "command": "simpler_flutter_generator.openConfigurator",
        "title": "4) Architecture Studio",
        "icon": "settings-gear"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "simpler_flutter_generator.enableCodeLensCommand",
          "group": "navigation",
          "when": "editorLangId == yaml && (resourceFilename == 'pubspec.yaml' || resourceLangId == '.yaml')"
        },
        {
          "command": "simpler_flutter_generator.generateImages",
          "group": "navigation",
          "when": "editorLangId == dart || editorLangId == yaml"
        },
        {
          "command": "simpler_flutter_generator.build_runner_with_filter_editor",
          "group": "navigation",
          "when": "editorLangId == dart"
        },
        {
          "command": "simpler_flutter_generator.openMenu",
          "group": "navigation",
          "when": "editorLangId == dart || editorLangId == yaml"
        }
      ],
      "editor/title": [
        {
          "command": "simpler_flutter_generator.openMenu",
          "group": "navigation",
          "when": "editorLangId == dart || editorLangId == yaml"
        }
      ],
      "explorer/context": [
        {
          "command": "simpler_flutter_generator.build_runner_with_filter",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "simpler_flutter_generator.generateFromYaml",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "simpler_flutter_generator.generateImages",
          "group": "navigation",
          "when": "explorerResourceIsFolder || filesExplorerFocus"
        },
        {
          "command": "simpler_flutter_generator.openMenu",
          "group": "navigation"
        }
      ],
      "contextMenu": [
        {
          "command": "simpler_flutter_generator.generateImages",
          "group": "navigation",
          "when": "editorLangId == dart"
        }
      ]
    },
    "configuration": {
      "title": "Simpler Flutter Generator",
      "properties": {
        "SimplerFlutterGenerator.stateMachine": {
          "type": "string",
          "default": "bloc",
          "enum": [
            "bloc",
            "cubit"
          ],
          "enumDescriptions": [
            "Use Bloc",
            "Use Cubit"
          ],
          "description": "Use Bloc or Use Cubit"
        },
        "SimplerFlutterGenerator.stateWidget": {
          "type": "string",
          "default": "StateLessWidget",
          "enum": [
            "StateFullWidget",
            "StateLessWidget",
            "Empty"
          ],
          "enumDescriptions": [
            "State -> StateFullWidget",
            "State -> StateLessWidget",
            "State -> Empty"
          ],
          "description": "Complete type of State Widget"
        },
        "SimplerFlutterGenerator.createStateWidget": {
          "type": "boolean",
          "default": true,
          "enum": [
            true,
            false
          ],
          "enumDescriptions": [
            "Create Widget -> true",
            "Create Widget -> false"
          ],
          "description": "Fill an empty NAME_page.dart / NAME_screen.dart with a State Widget"
        },
        "SimplerFlutterGenerator.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "enum": [
            true,
            false
          ],
          "enumDescriptions": [
            "enable -> true",
            "disable -> false"
          ],
          "description": "Show package version CodeLens in pubspec.yaml"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "publish:all": "npm run publish:vsce && npm run publish:ovsx"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.4",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.47.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "js-yaml": "^4.3.2"
  }
}